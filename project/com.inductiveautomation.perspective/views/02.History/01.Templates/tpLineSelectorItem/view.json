{
  "custom": {},
  "params": {
    "label": "L1",
    "selected": false
  },
  "props": {
    "defaultSize": {
      "height": 22,
      "width": 180
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "gap": "7px"
      }
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "Selected"
        },
        "props": {
          "selected": false
        },
        "type": "ia.input.checkbox",
        "position": {
          "basis": "22px",
          "shrink": 0
        },
        "propConfig": {
          "props.selected": {
            "binding": {
              "config": {
                "path": "view.params.selected"
              },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": {
          "name": "Label"
        },
        "props": {
          "text": "L1",
          "style": {
            "classes": "text/caption",
            "color": "var(--label)"
          }
        },
        "type": "ia.display.label",
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        }
      }
    ]
  }
}
