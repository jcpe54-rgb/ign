{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 1080,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Navigation"
        },
        "props": {
          "path": "00.Common/Navigation"
        },
        "type": "ia.display.view",
        "position": {
          "basis": "50px",
          "shrink": 0
        }
      },
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "props": {
              "style": {
                "classes": "text/title"
              },
              "text": "Históricos"
            },
            "type": "ia.display.label",
            "position": {
              "basis": "56px",
              "shrink": 0
            }
          },
          {
            "meta": {
              "name": "Filters"
            },
            "props": {
              "path": "02.History/01.Templates/tpHistoryFilters",
              "params": {
                "filters": {
                  "from": null,
                  "to": null,
                  "lines": []
                }
              }
            },
            "type": "ia.display.view",
            "position": {
              "basis": "94px",
              "shrink": 0
            }
          },
          {
            "children": [
              {
                "meta": {
                  "name": "TimelineTitle"
                },
                "props": {
                  "style": {
                    "classes": "text/subtitle"
                  },
                  "text": "Timeline de producción"
                },
                "type": "ia.display.label",
                "position": {
                  "basis": "32px",
                  "shrink": 0
                }
              },
              {
                "meta": {
                  "name": "TimelineRows"
                },
                "props": {
                  "path": "02.History/01.Templates/tpTimelineRow",
                  "direction": "column",
                  "instances": [
                    {}
                  ],
                  "style": {
                    "gap": "10px"
                  }
                },
                "type": "ia.display.flex-repeater",
                "position": {
                  "grow": 1
                }
              }
            ],
            "meta": {
              "name": "TimelinePanel"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "card/panel",
                "gap": "14px"
              }
            },
            "type": "ia.container.flex",
            "position": {
              "grow": 1,
              "shrink": 1
            }
          },
          {
            "children": [
              {
                "meta": {
                  "name": "TableTitle"
                },
                "props": {
                  "style": {
                    "classes": "text/subtitle"
                  },
                  "text": "Detalle histórico"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "TablePlaceholder"
                },
                "props": {
                  "style": {
                    "classes": "text/caption"
                  },
                  "text": "Sin datos"
                },
                "type": "ia.display.label",
                "position": {
                  "grow": 1
                }
              }
            ],
            "meta": {
              "name": "TablePanel"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "card/panel",
                "gap": "12px"
              }
            },
            "type": "ia.container.flex",
            "position": {
              "basis": "294px",
              "shrink": 0
            }
          }
        ],
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "padding": "30px 38px 24px",
            "gap": "22px",
            "backgroundColor": "var(--containerRoot)",
            "boxSizing": "border-box",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "var(--containerRoot)",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
