            "props": {
              "direction": "column",
              "style": {
                "classes": "card/panel",
                "gap": "14px"
              }
            },
            "type": "ia.container.flex",
            "position": {
              "grow": 1,
              "basis": "0px"
            }
          },
          {
            "children": [
              {
                "meta": {
                  "name": "PalletizersTitle"
                },
                "props": {
                  "style": {
                    "classes": "text/subtitle"
                  },
                  "text": "Paletizadores"
                },
                "type": "ia.display.label",
                "position": {
                  "basis": "32px",
                  "shrink": 0
                }
              },
              {
                "meta": {
                  "name": "Palletizers"
                },
                "props": {
                  "path": "04.Settings/01.Templates/tpPalletizerConfig",
                  "direction": "column",
