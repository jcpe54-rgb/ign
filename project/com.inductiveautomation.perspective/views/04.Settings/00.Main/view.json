{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 1080,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Navigation"
        },
        "props": {
          "path": "00.Common/Navigation"
        },
        "type": "ia.display.view",
        "position": {
          "basis": "50px",
          "shrink": 0
        }
      },
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "props": {
              "style": {
                "classes": "text/title"
              },
              "text": "Configuración"
            },
            "type": "ia.display.label",
            "position": {
              "basis": "64px",
              "shrink": 0
            }
          },
          {
            "children": [
              {
                "meta": {
                  "name": "LinesTitle"
                },
                "props": {
                  "style": {
                    "classes": "text/subtitle"
                  },
                  "text": "Líneas"
                },
                "type": "ia.display.label",
                "position": {
                  "basis": "32px",
                  "shrink": 0
                }
              },
              {
                "meta": {
                  "name": "Lines"
                },
                "props": {
                  "path": "04.Settings/01.Templates/tpLineConfig",
                  "direction": "column",
                  "instances": [
                    {}
                  ],
                  "style": {
                    "gap": "10px"
                  }
                },
                "type": "ia.display.flex-repeater",
                "position": {
                  "grow": 1
