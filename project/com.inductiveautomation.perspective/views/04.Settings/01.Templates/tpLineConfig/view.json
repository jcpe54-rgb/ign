{
  "custom": {},
  "params": {
    "lineConfig": {
      "id": "",
      "name": "—",
      "basePath": "",
      "palletizerId": ""
    }
  },
  "props": {
    "defaultSize": {
      "height": 58,
      "width": 900
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "card/base",
        "padding": "8px 12px",
        "gap": "10px"
      }
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "Id"
        },
        "props": {
          "text": "—",
          "style": {
            "classes": "text/label",
            "fontWeight": 700
          }
        },
        "type": "ia.display.label",
        "position": {
          "basis": "60px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.lineConfig.id"
              },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": {
          "name": "Name"
        },
        "props": {
          "text": "",
          "placeholder": "Nombre visible",
          "style": {
            "border": "var(--containerBorder)",
            "borderRadius": "var(--borderRadiusInput)"
          }
        },
        "type": "ia.input.text-field",
        "position": {
          "basis": "170px",
          "shrink": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.lineConfig.name"
              },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": {
          "name": "BasePath"
        },
        "props": {
          "text": "",
          "placeholder": "Base path sin configurar",
          "style": {
            "border": "var(--containerBorder)",
            "borderRadius": "var(--borderRadiusInput)"
          }
        },
        "type": "ia.input.text-field",
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.lineConfig.basePath"
              },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": {
          "name": "Palletizer"
        },
        "props": {
          "options": [
            {
              "label": "P1",
              "value": "P1"
            },
            {
              "label": "P2",
              "value": "P2"
            },
            {
              "label": "P3",
              "value": "P3"
            },
            {
              "label": "P4",
              "value": "P4"
            },
            {
              "label": "P5",
              "value": "P5"
            }
          ],
          "value": null,
          "placeholder": "Paletizador",
          "style": {
            "minHeight": "36px",
            "backgroundColor": "var(--input)",
            "border": "var(--containerBorder)",
            "borderRadius": "var(--borderRadiusInput)"
          }
        },
        "type": "ia.input.dropdown",
        "position": {
          "basis": "130px",
          "shrink": 0
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.lineConfig.palletizerId"
              },
              "type": "property"
            }
          }
        }
      }
    ]
  }
}
