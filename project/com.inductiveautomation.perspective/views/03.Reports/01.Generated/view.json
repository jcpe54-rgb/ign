{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 1080,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Navigation"
        },
        "props": {
          "path": "00.Common/Navigation"
        },
        "type": "ia.display.view",
        "position": {
          "basis": "50px",
          "shrink": 0
        }
      },
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "props": {
              "style": {
                "classes": "text/title"
              },
              "text": "Reportes generados"
            },
            "type": "ia.display.label",
            "position": {
              "basis": "64px",
              "shrink": 0
            }
          },
          {
            "children": [
              {
                "meta": {
                  "name": "Header"
                },
                "props": {
                  "style": {
                    "classes": "text/subtitle"
                  },
                  "text": "Listado"
                },
                "type": "ia.display.label",
                "position": {
                  "basis": "36px",
                  "shrink": 0
                }
              },
              {
                "meta": {
                  "name": "Placeholder"
                },
                "props": {
                  "style": {
                    "classes": "text/caption"
                  },
                  "text": "Sin reportes generados"
                },
                "type": "ia.display.label",
                "position": {
                  "grow": 1
                }
              }
            ],
            "meta": {
              "name": "GeneratedList"
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "card/panel",
                "gap": "12px"
              }
            },
            "type": "ia.container.flex",
            "position": {
              "grow": 1
            }
          }
        ],
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "padding": "32px 47px 64px",
            "gap": "21px",
            "backgroundColor": "var(--containerRoot)",
            "boxSizing": "border-box"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "var(--containerRoot)",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
