{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 72,
      "width": 1920
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Brand"
            },
            "props": {
              "style": {
                "classes": "text/subtitle"
              },
              "text": "PASTA CORTA"
            },
            "type": "ia.display.label",
            "position": {
              "basis": "220px",
              "shrink": 0
            }
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/overview\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Overview"
            },
            "position": {
              "basis": "150px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({page.props.path} = \"/overview\", \"control/primary\", \"control/secondary\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "text": "Overview",
              "primary": false
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/history\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "History"
            },
            "position": {
              "basis": "150px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({page.props.path} = \"/history\", \"control/primary\", \"control/secondary\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "text": "Históricos",
              "primary": false
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/reports\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Reports"
            },
            "position": {
              "basis": "150px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if(left({page.props.path}, 8) = \"/reports\", \"control/primary\", \"control/secondary\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "text": "Reportes",
              "primary": false
            },
            "type": "ia.input.button"
          },
          {
            "meta": {
              "name": "Spacer"
            },
            "position": {
              "grow": 1
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/settings\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Settings"
            },
            "position": {
              "basis": "150px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({page.props.path} = \"/settings\", \"control/primary\", \"control/secondary\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "text": "",
              "primary": false,
              "image": {
                "icon": {
                  "path": "material/settings"
                }
              }
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Navigation"
        },
        "position": {
          "basis": "100%"
        },
        "props": {
          "alignItems": "center",
          "style": {
            "classes": "layout/row"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "classes": "card/panel"
      }
    },
    "type": "ia.container.flex"
  }
}
