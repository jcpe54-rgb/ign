{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 1920
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "backgroundColor": "var(--container)",
        "borderBottom": "var(--containerBorder)",
        "boxSizing": "border-box",
        "padding": "0 34px",
        "gap": "12px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "LeftBrand"
        },
        "props": {
          "direction": "row",
          "alignItems": "center"
        },
        "type": "ia.container.flex",
        "position": {
          "basis": "420px",
          "shrink": 1
        },
        "children": [
          {
            "meta": {
              "name": "PrimaryLogoPlaceholder"
            },
            "props": {
              "text": "LOGO",
              "style": {
                "classes": "text/label",
                "border": "var(--containerBorder)",
                "borderRadius": "var(--borderRadius)",
                "textAlign": "center",
                "padding": "5px 14px",
                "boxSizing": "border-box",
                "color": "var(--neutral-60)"
              }
            },
            "type": "ia.display.label",
            "position": {
              "basis": "126px",
              "shrink": 0
            }
          }
        ]
      },
      {
        "meta": {
          "name": "NavigationLinks"
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "justify": "center",
          "style": {
            "gap": "18px"
          }
        },
        "type": "ia.container.flex",
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "children": [
          {
            "meta": {
              "name": "Overview"
            },
            "props": {
              "text": "Overview",
              "primary": false,
              "style": {
                "classes": "control/secondary",
                "backgroundColor": "transparent",
                "border": "none",
                "borderRadius": "0px",
                "boxShadow": "none",
                "color": "var(--label)",
                "fontSize": "14px",
                "fontWeight": 500,
                "minHeight": "50px",
                "padding": "0 10px"
              }
            },
            "type": "ia.input.button",
            "position": {
              "basis": "118px",
              "shrink": 1
            },
            "propConfig": {
              "props.style.borderBottom": {
                "binding": {
                  "config": {
                    "expression": "if({page.props.path} = \"/overview\", \"2px solid var(--callToAction)\", \"2px solid transparent\")"
                  },
                  "type": "expr"
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/overview\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "meta": {
              "name": "History"
            },
            "props": {
              "text": "Históricos",
              "primary": false,
              "style": {
                "classes": "control/secondary",
                "backgroundColor": "transparent",
                "border": "none",
                "borderRadius": "0px",
                "boxShadow": "none",
                "color": "var(--label)",
                "fontSize": "14px",
                "fontWeight": 500,
                "minHeight": "50px",
                "padding": "0 10px"
              }
            },
            "type": "ia.input.button",
            "position": {
              "basis": "118px",
              "shrink": 1
            },
            "propConfig": {
              "props.style.borderBottom": {
                "binding": {
                  "config": {
                    "expression": "if({page.props.path} = \"/history\", \"2px solid var(--callToAction)\", \"2px solid transparent\")"
                  },
                  "type": "expr"
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/history\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          },
          {
            "meta": {
              "name": "Reports"
            },
            "props": {
              "text": "Reportes",
              "primary": false,
              "style": {
                "classes": "control/secondary",
                "backgroundColor": "transparent",
                "border": "none",
                "borderRadius": "0px",
                "boxShadow": "none",
                "color": "var(--label)",
                "fontSize": "14px",
                "fontWeight": 500,
                "minHeight": "50px",
                "padding": "0 10px"
              }
            },
            "type": "ia.input.button",
            "position": {
              "basis": "118px",
              "shrink": 1
            },
            "propConfig": {
              "props.style.borderBottom": {
                "binding": {
                  "config": {
                    "expression": "if(left({page.props.path}, 8) = \"/reports\", \"2px solid var(--callToAction)\", \"2px solid transparent\")"
                  },
                  "type": "expr"
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/reports\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ]
      },
      {
        "meta": {
          "name": "RightMeta"
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "justify": "flex-end",
          "style": {
            "gap": "12px"
          }
        },
        "type": "ia.container.flex",
        "position": {
          "basis": "420px",
          "shrink": 1
        },
        "children": [
          {
            "meta": {
              "name": "User"
            },
            "props": {
              "direction": "column",
              "justify": "center",
              "style": {
                "gap": "0px"
              }
            },
            "type": "ia.container.flex",
            "position": {
              "basis": "120px",
              "shrink": 1
            },
            "children": [
              {
                "meta": {
                  "name": "UserName"
                },
                "props": {
                  "text": "Usuario",
                  "style": {
                    "classes": "text/label"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Role"
                },
                "props": {
                  "text": "Operador",
                  "style": {
                    "classes": "text/caption"
                  }
                },
                "type": "ia.display.label"
              }
            ]
          },
          {
            "meta": {
              "name": "DateTime"
            },
            "props": {
              "text": "21 SEP 2026 · 15:00",
              "style": {
                "classes": "text/caption",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label",
            "position": {
              "basis": "145px",
              "shrink": 1
            }
          },
          {
            "meta": {
              "name": "SecondaryLogoPlaceholder"
            },
            "props": {
              "text": "LOGO",
              "style": {
                "classes": "text/caption",
                "border": "var(--containerBorder)",
                "borderRadius": "var(--borderRadius)",
                "textAlign": "center",
                "padding": "5px 8px",
                "boxSizing": "border-box"
              }
            },
            "type": "ia.display.label",
            "position": {
              "basis": "70px",
              "shrink": 0
            }
          },
          {
            "meta": {
              "name": "Settings"
            },
            "props": {
              "text": "",
              "primary": false,
              "style": {
                "classes": "control/secondary",
                "backgroundColor": "transparent",
                "border": "none",
                "boxShadow": "none",
                "padding": "0",
                "minHeight": "36px"
              },
              "image": {
                "icon": {
                  "path": "material/settings"
                }
              }
            },
            "type": "ia.input.button",
            "position": {
              "basis": "42px",
              "shrink": 0
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tsystem.perspective.navigate(\"/settings\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
