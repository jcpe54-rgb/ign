{
  "custom": {},
  "params": {
    "kpi": {
      "id": "",
      "label": "",
      "value": "—",
      "unit": "",
      "icon": "material/assessment",
      "divider": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 88,
      "width": 300
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "backgroundColor": "transparent",
        "padding": "12px 18px",
        "boxSizing": "border-box",
        "gap": "10px"
      }
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "props": {
          "path": "material/assessment",
          "style": {
            "color": "var(--callToAction)",
            "width": "28px",
            "height": "28px"
          }
        },
        "type": "ia.display.icon",
        "position": {
          "basis": "34px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.kpi.icon"
              },
              "type": "property"
            }
          }
        }
      },
      {
        "meta": {
          "name": "Text"
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "gap": "3px"
          }
        },
        "type": "ia.container.flex",
        "position": {
          "grow": 1
        },
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "text/caption",
                "fontWeight": 600,
                "color": "var(--label)"
              }
            },
            "type": "ia.display.label",
            "position": {
              "basis": "18px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.kpi.label"
                  },
                  "type": "property"
                }
              }
            }
          },
          {
            "meta": {
              "name": "ValueRow"
            },
            "props": {
              "direction": "row",
              "alignItems": "end",
              "style": {
                "gap": "7px"
              }
            },
            "type": "ia.container.flex",
            "position": {
              "grow": 1
            },
            "children": [
              {
                "meta": {
                  "name": "Value"
                },
                "props": {
                  "text": "—",
                  "style": {
                    "classes": "text/value",
                    "fontSize": "24px"
                  }
                },
                "type": "ia.display.label",
                "position": {
                  "grow": 1,
                  "shrink": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.kpi.value"
                      },
                      "type": "property"
                    }
                  }
                }
              },
              {
                "meta": {
                  "name": "Unit"
                },
                "props": {
                  "text": "",
                  "style": {
                    "classes": "text/caption",
                    "alignSelf": "flex-end",
                    "paddingBottom": "3px"
                  }
                },
                "type": "ia.display.label",
                "position": {
                  "basis": "90px",
                  "shrink": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.kpi.unit"
                      },
                      "type": "property"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "propConfig": {
      "props.style.borderRight": {
        "binding": {
          "config": {
            "expression": "if({view.params.kpi.divider}, \"var(--containerBorder)\", \"none\")"
          },
          "type": "expr"
        }
      }
    }
  }
}
