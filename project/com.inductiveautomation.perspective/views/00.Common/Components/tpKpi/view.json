{
  "custom": {},
  "params": {
    "kpi": {
      "id": "",
      "label": "",
      "value": "—",
      "unit": "",
      "icon": "material/assessment",
      "divider": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 88,
      "width": 300
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "props": {
          "path": "material/assessment",
          "style": {
            "color": "var(--callToAction)",
            "width": "28px",
            "height": "28px"
          }
        },
        "type": "ia.display.icon",
        "position": {
          "basis": "34px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.kpi.icon"
              },
              "type": "property"
            }
          }
        }
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "text/caption",
                "fontWeight": 600,
                "color": "var(--label)",
                "fontSize": "10px",
                "whiteSpace": "nowrap"
              }
            },
            "type": "ia.display.label",
            "position": {
              "basis": "17px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.kpi.label"
                  },
                  "type": "property"
                }
              }
            }
          },
          {
            "meta": {
              "name": "Value"
            },
            "props": {
              "text": "—",
              "style": {
                "classes": "text/value",
                "fontSize": "24px",
                "lineHeight": "1.05"
              }
            },
            "type": "ia.display.label",
            "position": {
              "basis": "28px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.kpi.value"
                  },
                  "type": "property"
                }
              }
            }
          },
          {
            "meta": {
              "name": "Unit"
            },
            "props": {
              "text": "",
              "style": {
                "classes": "text/caption",
                "lineHeight": "1.1"
              }
            },
            "type": "ia.display.label",
            "position": {
              "basis": "15px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.kpi.unit"
                  },
                  "type": "property"
                }
              }
            }
          }
        ],
        "meta": {
          "name": "Text"
        },
        "props": {
          "direction": "column",
          "justify": "center",
          "style": {
            "gap": "1px"
          }
        },
        "type": "ia.container.flex",
        "position": {
          "grow": 1,
          "shrink": 1
        }
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "backgroundColor": "transparent",
        "padding": "10px 16px",
        "boxSizing": "border-box",
        "gap": "9px"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "props.style.borderRight": {
        "binding": {
          "config": {
            "expression": "if({view.params.kpi.divider}, \"var(--containerBorder)\", \"none\")"
          },
          "type": "expr"
        }
      }
    }
  }
}
