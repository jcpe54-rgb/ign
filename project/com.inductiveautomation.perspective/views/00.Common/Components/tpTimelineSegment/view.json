{
  "custom": {},
  "params": {
    "state": "inactive",
    "startMinute": 0,
    "durationMinutes": 1
  },
  "props": {
    "defaultSize": {
      "height": 12,
      "width": 60
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "stretch",
      "style": {
        "height": "100%"
      }
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "Bar"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "text/caption",
            "height": "100%",
            "minWidth": "2px",
            "borderRadius": "1px"
          }
        },
        "type": "ia.display.label",
        "position": {
          "grow": 1,
          "basis": "0px",
          "shrink": 1
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if({view.params.state} = \"running\", \"var(--state-running)\", if({view.params.state} = \"stopped\", \"var(--state-fault)\", \"var(--state-inactive)\"))"
              },
              "type": "expr"
            }
          }
        }
      }
    ],
    "propConfig": {
      "position.grow": {
        "binding": {
          "config": {
            "expression": "{view.params.durationMinutes}"
          },
          "type": "expr"
        }
      }
    }
  }
}
